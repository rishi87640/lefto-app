# ==============================================================================
# LEFTO Marketplace - Supabase Environment Variables
# ==============================================================================
# 1. Create a Supabase project at: https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy your Project URL into VITE_SUPABASE_URL
# 4. Copy your Project API anon/public key into VITE_SUPABASE_ANON_KEY
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: NEVER put your SUPABASE_SERVICE_ROLE_KEY or payment secret keys in Vite env!
# Public VITE_ prefixed keys are exposed to the browser client.
